<patternDefinitions>
<pattern name="patEpochSec"><![CDATA[\d{10}]]></pattern>
</patternDefinitions>

<eventFormatRecognizer><![CDATA[AWS_S3_LOG_GUARDDUTY]]></eventFormatRecognizer>
<parsingInstructions>

    <collectFieldsByRegex src="$_rawmsg">
              
        <regex><![CDATA[AWS_S3_LOG_GUARDDUTY:phCustId=<phCustId:gPatInt>,reptDevIpAddr=<reptDevIpAddr:gPatIpAddr>,reptDevName=<reptDevName:gPatStr>,msg=<_body:gPatMesgBody>]]></regex>
            
    </collectFieldsByRegex>
             
    <setEventAttribute attr="eventType">AWSS3-GUARDDUTY</setEventAttribute>
	
     
    <collectAndSetAttrByJSON src="$_body">
              
        <attrKeyMap attr="accountId" key="accountId"/>
              
        <attrKeyMap attr="description" key="description"/>
              
        <attrKeyMap attr="awsRegion" key="region"/>
              
        <attrKeyMap attr="resourceType" key="resource.resourceType"/>

        <attrKeyMap attr="_resourceRole" key="resource.resourceRole"/>		
            
		<attrKeyMap attr="serviceName" key="service.serviceName"/>		

		<attrKeyMap attr="feature" key="service.featureName"/>

        <attrKeyMap attr="_actionType" key="service.action.actionType"/>
		
		<attrKeyMap attr="_firstSeenTime" key="service.eventFirstSeen"/>

		<attrKeyMap attr="_lastSeenTime" key="service.eventLastSeen"/>		
              
        <attrKeyMap attr="eventSeverity" key="severity"/>
              
        <attrKeyMap attr="type" key="type"/>
              
        <attrKeyMap attr="_updateTime" key="updatedAt"/>
              
        <attrKeyMap attr="title" key="title"/>
           
    </collectAndSetAttrByJSON>
        
      
    <when test="exist type">
              
        <setEventAttribute attr="eventType">combineMsgId("AWS_GUARDDUTY-", $type)</setEventAttribute>
            
    </when>

    <when test="exist _firstSeenTime">
	
      <collectFieldsByRegex src="$_firstSeenTime">
              
          <regex><![CDATA[<_year:gPatYear>-<_mon:gPatMonNum>-<_day:gPatDay>T<_time:gPatTime>.\d+Z]]></regex>
            
      </collectFieldsByRegex>
        
    <setEventAttribute attr="firstSeenTime">toDateTime($_mon, $_day, $_year, $_time)</setEventAttribute>

    </when>

    <when test="exist _lastSeenTime">
	
      <collectFieldsByRegex src="$_lastSeenTime">
              
          <regex><![CDATA[<_year:gPatYear>-<_mon:gPatMonNum>-<_day:gPatDay>T<_time:gPatTime>.\d+Z]]></regex>
            
      </collectFieldsByRegex>
        
    <setEventAttribute attr="lastSeenTime">toDateTime($_mon, $_day, $_year, $_time)</setEventAttribute>

    </when>

    <when test="exist _updateTime">
	
      <collectFieldsByRegex src="$_updateTime">
              
          <regex><![CDATA[<_year:gPatYear>-<_mon:gPatMonNum>-<_day:gPatDay>T<_time:gPatTime>.\d+Z]]></regex>
            
      </collectFieldsByRegex>
        
    <setEventAttribute attr="updateTime">toDateTime($_mon, $_day, $_year, $_time)</setEventAttribute>

    </when>
	
</parsingInstructions>
